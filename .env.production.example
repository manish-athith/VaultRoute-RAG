APP_NAME=VaultRoute RAG
APP_VERSION=1.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO
ENABLE_API_DOCS=false
ALLOWED_HOSTS=rag.example.com,localhost

# Generate unique values; do not commit the completed production file.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
METRICS_BEARER_TOKEN=replace-with-at-least-24-random-characters
SEED_USER_PASSWORD=replace-or-disable-development-seeding

DATABASE_URL=postgresql+asyncpg://vaultroute:replace-password@postgres:5432/vaultroute
POSTGRES_PASSWORD=replace-password
QDRANT_URL=http://qdrant:6333

GROQ_API_KEY=
OPENAI_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_MODEL=gpt-6-astra

RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_QUERY_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10
