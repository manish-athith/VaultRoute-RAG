APP_NAME=VaultRoute RAG
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+asyncpg://vaultroute:vaultroute@localhost:5432/vaultroute
QDRANT_URL=http://localhost:6333
DEPENDENCY_TIMEOUT_SECONDS=3.0
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=vaultroute-rag
JWT_AUDIENCE=vaultroute-rag-api
JWT_ACCESS_TOKEN_MINUTES=30
SEED_USER_PASSWORD=ChangeMe123!
DOCUMENT_CHUNK_SIZE_WORDS=220
DOCUMENT_CHUNK_OVERLAP_WORDS=40
MAX_UPLOAD_BYTES=10485760
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=.model-cache
QDRANT_DOCUMENT_COLLECTION=document_chunks
QDRANT_CACHE_COLLECTION=semantic_answer_cache
RETRIEVAL_CANDIDATE_LIMIT=20
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.30
ANSWER_MIN_SCORE=0.50
CACHE_SIMILARITY_THRESHOLD=0.93
CACHE_CANDIDATE_LIMIT=5
CACHE_TTL_SECONDS=86400
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-astra
MODEL_REQUEST_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=700
GROQ_INPUT_COST_PER_MILLION=0.075
GROQ_OUTPUT_COST_PER_MILLION=0.30
OPENAI_INPUT_COST_PER_MILLION=10.0
OPENAI_OUTPUT_COST_PER_MILLION=50.0
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_QUERY_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10
METRICS_BEARER_TOKEN=
ENABLE_API_DOCS=true

